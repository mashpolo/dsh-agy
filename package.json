{
  "name": "dsh-antigravity",
  "version": "0.2.0-beta.3",
  "description": "DeepSeek Harness frontend for local Antigravity CLI sessions",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./client": "./dist/client.js"
  },
  "files": [
    "dist/index.js",
    "dist/client.js",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.5"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "esbuild": "^0.27.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "@deepseek-ai/dsh-credentials-local": "0.2.2-rc.5"
  }
}
